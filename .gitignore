cat > .gitignore << 'EOF'
# secrets
.env
.env.*
!.env.example

# python
env/
venv/
__pycache__/
*.pyc
*.db

# mobile / node
node_modules/
.expo/
dist/
android/app/build/
ios/Pods/

# divers
.DS_Store
.idea/
.vscode/
EOF
   # backend kept locally, excluded from Git (sauf les fichiers du module 6)
   /backend/*
   !/backend/modules/
   !/backend/main_module6.py
   !/backend/requirements-module6.txt